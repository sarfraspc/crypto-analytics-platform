# Common
ENVIRONMENT=local
APP_NAME=crypto-analytics-platform

# Database Configs (Superuser for container init)
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=your_superuser_password

# Metadata DB user
POSTGRES_USER=metadata_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=metadata_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

TIMESCALE_USER=crypto_user
TIMESCALE_PASSWORD=your_timescale_password
TIMESCALE_DB=crypto_db
TIMESCALE_HOST=db
TIMESCALE_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Vector DB (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=crypto_rag
QDRANT_HOST=qdrant

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_ARTIFACT_ROOT=gs://your-mlflow-bucket

# Sentiment model 
SENTIMENT_MODEL_ID=sarfras/crypto-sentiment-distilroberta

# Market ingestion defaults (VM)
MARKET_EXCHANGE_ID=kraken
MARKET_QUOTE_SYMBOL=USDT

# API Keys
COINGECKO_API_KEY=your_coingecko_api_key
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret
INFURA_PROJECT_ID=your_infura_project_id
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=YourApp/0.1 by YourUsername
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_API_KEY=your_gemini_api_key

# App Config
APP_ENV=development
APP_PORT=8000

# MCP Config
MCP_DISCOVERY=true
MCP_TIMEOUT=30

# Infura settings
INFURA_HTTPS=https://mainnet.infura.io/v3/your_infura_project_id
INFURA_WSS=wss://mainnet.infura.io/ws/v3/your_infura_project_id

# Other
ALTERNATIVE_ME_URL=https://api.alternative.me/fng/
CRYPTOPANIC_URL=https://cryptopanic.com/api/v1/posts/

# Google Cloud Config
GCS_MODEL_BUCKET=your-gcs-model-bucket
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# CORS
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173
