FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies based on lockfile for reproducible builds
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy the rest of the frontend source (without node_modules, dist, etc. thanks to .dockerignore)
COPY frontend/ .

# Build-time API base URL for the frontend.
# In docker-compose we pass VITE_API_URL=/api so the browser
# talks to the same origin and Nginx proxies /api to the backend.
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY infrastructure/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
